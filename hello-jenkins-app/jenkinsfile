pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Cloning repository...'
                checkout scm
            }
        }

        stage('Build') {
            steps {

                    sh 'pwd'
            }
        }

        stage('Archive') {
            steps {
                sh 'ls -la'
            }
        }
 
    }

    post {

        success {
            echo 'Application built successfully!'
        }

        failure {
            echo 'Build failed.'
        }

        always {
            echo 'Pipeline finished.'
        }

    }

}
