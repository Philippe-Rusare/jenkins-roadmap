pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Cloning repository...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('hello-jenkins-app') {
                    sh './mvnw clean package'
                }
            }
        }

        stage('Archive') {
            steps {
                archiveArtifacts artifacts: 'hello-jenkins-app/target/*.jar'
            }
        }

         stage('deploy') {
            steps {
                dir('hello-jenkins-app') {
                    sh './mvnw spring-boot:run'
                }
            }
        }
 
    }

    post {

        success {
            echo 'Application built successfully!'
        }

        failure {
            echo 'Build failed.'
        }

        always {
            echo 'Pipeline finished.'
        }

    }

}
