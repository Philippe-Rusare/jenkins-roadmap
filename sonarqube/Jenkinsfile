pipeline {

    agent any

    environment {

        IMAGE_NAME = "hello-jenkins-app-docker-integration"
        IMAGE_TAG  = "${BUILD_NUMBER}"

        SONAR_URL = "http://72.60.129.189:9000"
    }

    stages {

        stage('Build Application') {

            steps {

                dir('sonarqube') {

                    sh "./mvnw clean package"

                }

            }

        }

        stage('SonarQube Analysis') {

            steps {

                dir('sonarqube') {

                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONARQUBE_TOKEN'
                        )
                    ]) {

                        sh '''
                        ./mvnw clean verify \
                        org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                        -Dsonar.host.url=$SONAR_URL \
                        -Dsonar.token=$SONARQUBE_TOKEN \
                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''

                    }

                }

            }

        }

        stage('Build Docker Image') {

            steps {

                dir('sonarqube') {

                    sh """
                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    .
                    """

                }

            }

        }

        stage('List Docker Images') {

            steps {

                sh "docker images"

            }

        }

    }

    post {

        success {

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {

                sh """
                curl -s -X POST https://api.telegram.org/\$BOT_TOKEN/sendMessage \
                -d chat_id=\$CHAT_ID \
                --data-urlencode "text=🚀 Jenkins Pipeline SUCCESS

✅ Projet : ${JOB_NAME}
🔢 Build : #${BUILD_NUMBER}
🐳 Docker : ${IMAGE_NAME}:${IMAGE_TAG}

📊 SonarQube : Analyse terminée

🌐 Jenkins :
${BUILD_URL}"
                """

            }

        }

        failure {

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {

                sh """
                curl -s -X POST https://api.telegram.org/\$BOT_TOKEN/sendMessage \
                -d chat_id=\$CHAT_ID \
                --data-urlencode "text=❌ Jenkins Pipeline FAILED

🚨 Projet : ${JOB_NAME}

🔢 Build : #${BUILD_NUMBER}

📌 Consulte les logs :

${BUILD_URL}"
                """

            }
 
        }

        always {

            echo "Pipeline terminé."

        }

    }

}