pipeline {

    agent any

    environment {

        IMAGE_NAME = "hello-jenkins-app-sonarqube-integration"
        IMAGE_TAG = "${BUILD_NUMBER}"

        SONAR_URL = "http://72.60.129.189:9000"
        SONAR_PROJECT = "com.philipperusare:hello-jenkins-app"
        SONAR_DASHBOARD = "${SONAR_URL}/dashboard?id=${SONAR_PROJECT}"

    }

    stages {

        stage('Build Application') {

            steps {

                dir('sonarqube') {

                    sh "./mvnw clean package"

                }

            }

        }

        stage('SonarQube Analysis') {

            steps {

                dir('sonarqube') {

                    withCredentials([
                        string(
                            credentialsId: 'sonarqube-token',
                            variable: 'SONARQUBE_TOKEN'
                        )
                    ]) {

                        sh '''
                        ./mvnw verify \
                        org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                        -Dsonar.host.url=http://72.60.129.189:9000 \
                        -Dsonar.token=$SONARQUBE_TOKEN
                        '''

                    }

                }

            }

        }

        stage('Quality Gate') {

            steps {

                timeout(time: 5, unit: 'MINUTES') {

                    script {

                        def qualityGate = waitForQualityGate()

                        env.SONAR_STATUS = qualityGate.status

                        if (qualityGate.status != 'OK') {

                            error "Quality Gate Failed : ${qualityGate.status}"

                        }

                    }

                }

            }

        }

        stage('Build Docker Image') {

            steps {

                dir('sonarqube') {

                    sh """
                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} \
                    .
                    """

                }

            }

        }

        stage('List Docker Images') {

            steps {

                sh "docker images"

            }

        }

    }

    post {

        success {

            script {

                env.DURATION = currentBuild.durationString.replace(" and counting","")
                env.SHORT_SHA = GIT_COMMIT.take(7)

            }

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {

                sh """
                curl -s -X POST https://api.telegram.org/\$BOT_TOKEN/sendMessage \
                -d chat_id=\$CHAT_ID \
                --data-urlencode "text=

                🚀 Jenkins CI/CD DevOps

                ✅ BUILD SUCCESS

                📦 Project: ${JOB_NAME}
                🔢 Build: #${BUILD_NUMBER}
                🌿 Branch: ${GIT_BRANCH}
                👤 Author: ${GIT_AUTHOR}

                📝 Commit: ${GIT_MESSAGE}
                🔖 SHA: ${SHORT_SHA}

                🔍 SonarQube: ✅ ${SONAR_STATUS}
                📊 Dashboard: ${SONAR_DASHBOARD}

                🐳 Docker Image: ${IMAGE_NAME}:${IMAGE_TAG}

                ⏱ Duration: ${DURATION}
                🔗 Jenkins: ${BUILD_URL}
                "

                """

            }

        }

        failure {

            script {

                env.DURATION = currentBuild.durationString.replace(" and counting","")

                if (!env.SONAR_STATUS) {
                    env.SONAR_STATUS = "FAILED"
                }

            }

            withCredentials([
                string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
            ]) {

                sh """
                curl -s -X POST https://api.telegram.org/\$BOT_TOKEN/sendMessage \
                -d chat_id=\$CHAT_ID \
                --data-urlencode "text=

                ❌ Jenkins CI/CD DevOps

                🚨 BUILD FAILED

                📦 Project: ${JOB_NAME}
                🔢 Build: #${BUILD_NUMBER}
                🌿 Branch: ${GIT_BRANCH}
                👤 Author: ${GIT_AUTHOR}

                📝 Commit: ${GIT_MESSAGE}
                🔖 SHA: ${GIT_COMMIT}

                🔍 SonarQube: ${SONAR_STATUS}

                ⏱ Duration: ${DURATION}
                🔗 Jenkins Logs
                ${BUILD_URL}"

                """

            }

        }

        always {

            cleanWs()

        }

    }

}